                                       640,
                                       220
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const client = $(\u0027Upload statement\u0027).first().json.Client;\nconst E = $json.output.entries || [];\nconst rows = E.map(e =\u003e ({ json: { Client: client, Date: e.date, Narration: e.narration, Amount: e.amount, \u0027Dr/Cr\u0027: e.type,\n  Ledger: e.ledger, Confidence: e.confidence, Status: e.confidence \u003c 0.7 ? \u0027CHECK\u0027 : \u0027Draft\u0027 } }));\nconst dr = E.filter(e =\u003e e.type === \u0027Dr\u0027).reduce((s, e) =\u003e s + Number(e.amount), 0);\nconst cr = E.filter(e =\u003e e.type === \u0027Cr\u0027).reduce((s, e) =\u003e s + Number(e.amount), 0);\nrows.forEach(r =\u003e Object.assign(r.json, { _total_dr: dr, _total_cr: cr, _count: E.length, _check: E.filter(e =\u003e e.confidence \u003c 0.7).length }));\nreturn rows;"
                                     },
