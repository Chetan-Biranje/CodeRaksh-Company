# Copy to .env (git-ignored). Every value is a placeholder.
CODERAKSH_MODE=mock                 # mock | live. Live also needs an approved scope file.
CODERAKSH_RUN_BUDGET=500            # credits per run; values above 500 are clamped to 500
CODERAKSH_DATA_DIR=./data
CODERAKSH_PROGRAMS_DIR=./programs
CODERAKSH_API_TOKEN=                # required by the FastAPI server; generate: openssl rand -hex 32

# Tapline REST. Defaults are verified from Tapline's official docs: base URL https://api.tapline.sh,
# header X-API-Key with the bare key. You normally set only the key.
TAPLINE_API_KEY=
# TAPLINE_BASE_URL=https://api.tapline.sh
# TAPLINE_AUTH_HEADER=X-API-Key
# TAPLINE_MIN_INTERVAL=1.0          # seconds between requests (free tier is 1 request/second)
# TAPLINE_ALLOW_CUSTOM_HOST=1       # only for a mock server in tests; never with a real key
# CODERAKSH_ENABLE_DOCS=1           # expose /docs on the API (off by default)

# Optional, raise public rate limits
NVD_API_KEY=
GITHUB_TOKEN=
