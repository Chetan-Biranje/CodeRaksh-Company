    "camel:roleplay": "python camel_workforce.py --roleplay",
    "bot": "python bot/server.py",
    "leads": "node lead-finder.js",
    "setup": "python setup.py",
    "test": "python -m pytest tests/ && node .agents/skills/security-audit/validate-findings.test.cjs && node .agents/skills/security-audit/validate-coverage-ledger.test.cjs"
