                      "id":  "164b9f8b-398e-4dbd-ad57-17483d8b972c",
                      "name":  "Read invoices",
                      "type":  "n8n-nodes-base.googleSheets",
                      "typeVersion":  4.5,
                      "position":  [
                                       220,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const today = $now.startOf(\u0027day\u0027);\nconst out = [];\nfor (const { json: r } of $input.all()) {\n  if (String(r[\u0027Status\u0027]).toLowerCase() === \u0027paid\u0027 || !r[\u0027Due date\u0027] || !r[\u0027Email\u0027]) continue;\n  const days = Math.floor(today.diff(DateTime.fromISO(String(r[\u0027Due date\u0027])), \u0027days\u0027).days);\n  if (days \u003c 1) continue;\n  if (r[\u0027Last reminder\u0027] === today.toISODate()) continue;\n  const tone = days \u003c= 7 ? \u0027friendly\u0027 : days \u003c= 21 ? \u0027firm\u0027 : \u0027final\u0027;\n  out.push({ json: { ...r, days_overdue: days, tone, reminders: Number(r[\u0027Reminders sent\u0027] || 0) } });\n}\nreturn out;"
                                     },
                      "id":  "dc997e0c-2cb2-4ca3-9f6d-d70088c9cd11",
                      "name":  "Find overdue",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       440,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "promptType":  "define",
                                         "text":  "=You write payment reminder emails for Coderaksha (a small agency).\n\nInvoice {{ $json[\u0027Invoice No\u0027] }} for {{ $json[\u0027Amount\u0027] }} to {{ $json[\u0027Client\u0027] }} (contact: {{ $json[\u0027Contact name\u0027] }}) was due on {{ $json[\u0027Due date\u0027] }}. It is {{ $json.days_overdue }} days overdue. Reminders already sent: {{ $json.reminders }}.\n\nTone: {{ $json.tone }}.\n- friendly: assume they forgot, short and warm.\n- firm: clear, mention the due date and ask for a payment date.\n- final: polite but serious, say work may pause and late fees may apply per our terms.\n\nMax 120 words. No guilt-tripping. Return a subject and a plain-text body signed \u0027Accounts, Coderaksha\u0027.",
                                         "hasOutputParser":  true
                                     },
