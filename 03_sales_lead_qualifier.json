                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ JSON.stringify({\n  model: \u0027claude-opus-5-5\u0027,\n  max_tokens: 300,\n  system: \u0027You qualify inbound sales leads. hot = clear buying intent (asks for price, call, demo, or gives budget/timeline). warm = interested but vague, no urgency. cold = spam, irrelevant, job seekers, or no intent. Always answer by calling the qualify_lead tool.\u0027,\n  tools: [\n    {\n      name: \u0027qualify_lead\u0027,\n      description: \u0027Record the qualification of a lead.\u0027,\n      input_schema: {\n        type: \u0027object\u0027,\n        properties: {\n          status: { type: \u0027string\u0027, enum: [\u0027hot\u0027, \u0027warm\u0027, \u0027cold\u0027] },\n          reason: { type: \u0027string\u0027, description: \u0027One short sentence explaining the status.\u0027 }\n        },\n        required: [\u0027status\u0027, \u0027reason\u0027]\n      }\n    }\n  ],\n  tool_choice: { type: \u0027tool\u0027, name: \u0027qualify_lead\u0027 },\n  messages: [\n    { role: \u0027user\u0027, content: \u0027Lead data:\\n\u0027 + JSON.stringify($json.body) }\n  ]\n}) }}",
                                         "options":  {

                                                     }
                                     },
                      "id":  "e5d18b94-f109-459d-949a-3a4d05f21753",
                      "name":  "Claude Qualify",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       220,
                                       0
                                   ],
                      "onError":  "continueRegularOutput"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const lead = $(\u0027Webhook\u0027).first().json.body ?? {};\nconst res = $input.first().json ?? {};\nconst tool = (res.content ?? []).find((c) =\u003e c.type === \u0027tool_use\u0027);\nconst q = tool?.input ?? {};\nconst ok = [\u0027hot\u0027, \u0027warm\u0027, \u0027cold\u0027].includes(q.status);\n\nreturn [\n  {\n    json: {\n      Timestamp: new Date().toISOString(),\n      Name: lead.name ?? \u0027\u0027,\n      Phone: lead.phone ?? \u0027\u0027,\n      Email: lead.email ?? \u0027\u0027,\n      Source: lead.source ?? \u0027\u0027,\n      Message: lead.message ?? \u0027\u0027,\n      Status: ok ? q.status : \u0027warm\u0027,\n      Reason: ok ? q.reason ?? \u0027\u0027 : \u0027AI qualification failed - review manually\u0027,\n    },\n  },\n];"
                                     },
